# Copy this file to .env to configure your local demo.
# NEVER commit .env; pick a different admin key before sharing outside localhost.
ADMIN_API_KEY=local-demo-key-change-me
API_BASE_URL=http://127.0.0.1:8000
DB_PATH=data/supportflow.db
# Knowledge-base automatic reply cutoff: 0.00 to 1.00
MIN_CONFIDENCE=0.68
# lexical = built-in offline retrieval; chroma = optional local ChromaDB vector store
RETRIEVER_BACKEND=lexical
# Optional local Ollama rewrite mode (OFF by default, never overrides policy decisions)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
